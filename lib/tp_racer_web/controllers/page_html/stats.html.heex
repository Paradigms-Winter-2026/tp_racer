<Layouts.flash_group flash={@flash} />
<div class="mx-50 flex flex-col">
<div class="flex flex-row rounded-lg gap-10 bg-slate-800">
  <.user_info user_name={@user_name}/>
  <.stat_card label="tests started" value={@tests_started} />
  <.stat_card label="tests completed" value={@tests_completed} />
  <.stat_card label="time typing" value={@time_typing} />
</div>
<.games games={@games} />
</div>
