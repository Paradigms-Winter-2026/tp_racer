<Layouts.flash_group flash={@flash} />
<div class="flex flex-row gap-3">
  <div class="flex flex-col">
    <h1><%= @user_name %></h1>
  </div>
  <div class="flex flex-col">
    <p>tests started</p>
    <p><%= @tests_started %></p>
  </div>
  <div class="flex flex-col">
    <p>tests completed</p>
    <p><%= @tests_completed %></p>
  </div>
  <div class="flex flex-col">
    <p>time typing</p>
    <p><%= @time_typing %></p>
  </div>
</div>

